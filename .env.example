# Copie a apps/web/.env.local y a la raíz según necesite. No suba secretos reales al repositorio.
DATABASE_URL=postgres://ls_app:CAMBIAR@127.0.0.1:5439/leadersource_dev
DATABASE_OWNER_URL=postgres://ls_owner:CAMBIAR@127.0.0.1:5439/leadersource_dev
# 32 bytes en base64 (openssl rand -base64 32). Cifra los secretos TOTP.
APP_ENCRYPTION_KEY=
# Proxies de confianza delante de la aplicación (obligatorio en producción; 0 en desarrollo)
TRUSTED_PROXY_HOPS=0
APP_URL=http://localhost:3000
# Almacenamiento de documentos: s3 (producción) o fs (solo desarrollo local)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=ls-private
S3_BUCKET_PUBLIC=ls-public
S3_BUCKET_QUARANTINE=ls-quarantine
S3_BUCKET_SCORM=ls-scorm
# Origen separado para el contenido de paquetes SCORM/xAPI (otro host o puerto que APP_URL)
CONTENT_URL=http://127.0.0.1:3000
# Análisis de archivos: clamav (producción) o off (solo desarrollo, marca los archivos como "skipped")
SCAN_DRIVER=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Fase 4: paquetes SCORM / xAPI ---
SCORM_MAX_PACKAGE_MB=200
SCORM_MAX_UNPACKED_MB=1024
SCORM_MAX_FILES=10000
# Reenvío opcional de statements xAPI a un LRS externo. Sin estas variables no se reenvía nada.
XAPI_LRS_ENDPOINT=
XAPI_LRS_KEY=
XAPI_LRS_SECRET=
# Secreto (24+ caracteres) para disparar /api/xapi/forward desde un planificador externo. No hay planificador instalado.
XAPI_FORWARD_SECRET=
