# Plantilla de variables de producción. Cópiela a .env.production, rellene y NO la suba al repositorio.
# Genere las claves con:  openssl rand -base64 32
DATABASE_URL=postgres://ls_app:CAMBIAR@db.interno:5432/leadersource?sslmode=require
DATABASE_OWNER_URL=postgres://ls_owner:CAMBIAR@db.interno:5432/leadersource?sslmode=require
APP_ENCRYPTION_KEY=
XAPI_ACTOR_KEY=
# Nº de proxies de confianza delante (1 = nginx que pone la IP del cliente al final de X-Forwarded-For; 2 = CDN + nginx)
TRUSTED_PROXY_HOPS=1
APP_URL=https://campus.ejemplo.org
CONTENT_URL=https://contenido.ejemplo.org
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
XAPI_FORWARD_SECRET=
BACKUP_AGE_RECIPIENT=
TAG=latest
